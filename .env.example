# Travel Expense Manager - Environment Variables Example
# Copy this file to .env and update the values as needed

# Backend Configuration
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173
DEFAULT_INCIDENTAL_AMOUNT=5.0

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# Optional: PostgreSQL Configuration
# Uncomment and configure if using PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travelexpenses
# POSTGRES_DB=travelexpenses
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
